# Browser Use / Browser Agent Configuration
# Copy to .env and fill only the credentials you actually use.

# Local-first: leave this blank to avoid Browser Use Cloud usage.
BROWSER_USE_API_KEY=

# Required for the default Indian runtime example.
GOOGLE_API_KEY=

# Application regional defaults (safe to override per deployment).
BROWSER_AGENT_COUNTRY=IN
BROWSER_AGENT_LOCALE=en-IN
BROWSER_AGENT_TIMEZONE=Asia/Kolkata
BROWSER_AGENT_CURRENCY=INR

# Browser Use logging.
BROWSER_USE_LOGGING_LEVEL=info
CDP_LOGGING_LEVEL=WARNING
ANONYMIZED_TELEMETRY=false

# Optional browser settings (normally managed by Browser Harness).
# BROWSER_USE_EXECUTABLE_PATH=
# BROWSER_USE_HEADLESS=false
# BROWSER_USE_USER_DATA_DIR=

# Optional proxy settings for enterprise/network deployments.
# BROWSER_USE_PROXY_SERVER=
# BROWSER_USE_NO_PROXY=localhost,127.0.0.1
# BROWSER_USE_PROXY_USERNAME=
# BROWSER_USE_PROXY_PASSWORD=
